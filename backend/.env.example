NODE_ENV=
PORT=
POSTGRES_PORT=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=
BCRYPT_COST=
JWT_SECRET=
JWT_EXPIRES_SEC=
REFRESH_TOKEN_EXPIRES_DAYS=
# Opcional: path del cookie de refresh_token. Dejar sin definir (o "/auth") en
# desarrollo, donde el frontend le pega directo al backend. En produccion,
# detras del rewrite de Vercel (frontend/vercel.json), el frontend llama a
# /api/auth/refresh, asi que hay que setear esto a "/api/auth" para que el
# navegador siga mandando la cookie (RFC 6265: el Path del cookie tiene que
# ser un prefijo del path de la request).
REFRESH_TOKEN_COOKIE_PATH=
USERS_SOURCE=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Opcional: dominio público del bucket. Si no se define, las fotos se sirven con URL firmada temporal.
R2_PUBLIC_URL=
